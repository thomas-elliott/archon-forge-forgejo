{
  "name": "archon-forge-forgejo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-arm64 && bun run build:darwin-x64",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/plugin.ts --outfile dist/linux-x64/archon-forge-forgejo",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 ./src/plugin.ts --outfile dist/linux-arm64/archon-forge-forgejo",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/plugin.ts --outfile dist/darwin-arm64/archon-forge-forgejo",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 ./src/plugin.ts --outfile dist/darwin-x64/archon-forge-forgejo",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "check": "biome check --error-on-warnings . && tsc --noEmit && bun test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
